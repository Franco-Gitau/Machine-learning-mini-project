
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import KFold, cross_val_score
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.neural_network import MLPClassifier
from sklearn.svm import SVC

df = pd.read_csv(r"C:\Users\franc\Downloads\Crop_recommendation.csv")
print("Dataset shape:", df.shape)
print(df.head())

X = df.drop("label", axis = 1)
y = df["label"]

label_encoder = LabelEncoder()
y_encoded = label_encoder.fit_transform(y)

scaler= StandardScaler()
X_scaled = scaler.fit_transform(X)

models = { 
    "KNN" : KNeighborsClassifier(n_neighbors=5),
    "Decision Tree": DecisionTreeClassifier(random_state=42),
    "ANN (MLP)": MLPClassifier(hidden_layer_sizes=(64, 32), max_iter=1000, random_state=42),
    "SVM": SVC(kernel="rbf", random_state=42),
}

kf = KFold(n_splits=2, shuffle=True, random_state=42)

results={}
for name, model in models.items():
    scores = cross_val_score(model, X_scaled, y_encoded, cv=kf, scoring="accuracy")
    results[name] = scores
    print(f"{name}: fold accuracies = {scores.round(4)},mean accuracy = {scores.mean():.4f}")

results_df = pd.DataFrame(results, index=["Fold 1","Fold 2"]).T
results_df["Mean Accuracy"] = results_df.mean(axis=1)
results_df.to_csv("model_comparison_results.csv")
print("\nsaved results table to model_comparison_results.csv")
print(results_df)

plt.figure(figsize=(8, 5))
plt.bar(results_df.index, results_df["Mean Accuracy"], color=["#4C72B0", "#551868", "#C44E52", "#8172B2"])
plt.ylabel("Mean Accuracy (2-fold CV)")
plt.title("Model Comparison: KNN vs Decision Tree vs ANN vs SVM ")
plt.ylim(0, 1)
for i, v in enumerate(results_df["Mean Accuracy"]):
    plt.text(i, v + 0.02, f"{v:.3f}", ha="center")
plt.tight_layout()
plt.savefig("model_comparison_chart.png", dpi=200)
print("Saved chart to model_comparison_chart.png")

plt.show

from sklearn.tree import plot_tree

viz_tree = DecisionTreeClassifier(max_depth=3, random_state=42)
viz_tree.fit(X_scaled, y_encoded)

plt.figure(figsize=(16,8))
plot_tree(viz_tree, feature_names=X.columns, class_names=label_encoder.classes_, filled=True, rounded=True, fontsize=8)
plt.title("Decision Tree Structure (depth-limited to 3 for one to be able to read)")
plt.tight_layout()
plt.savefig("decision_tree_diagram.png", dpi=200)
print("Saved decision_tree_diagram.png")

plt.show

from sklearn.model_selection import cross_val_predict
from sklearn.metrics import ConfusionMatrixDisplay

fig, axes = plt.subplots(2, 2, figsize=(14, 12))
axes = axes.flatten()

for ax, (name, model) in zip(axes, models.items()):
    y_pred = cross_val_predict(model, X_scaled, y_encoded, cv=kf)
    ConfusionMatrixDisplay.from_predictions(
        y_encoded, y_pred, display_labels=label_encoder.classes_,
        ax=ax, xticks_rotation=90, colorbar=False
    )
    ax.set_title(name)

plt.tight_layout()
plt.savefig("confusion_matrices.png", dpi=200)
print("Saved confusion_matrices.png")

plt.show()

importances = viz_tree.feature_importances_
feat_importance_df = pd.DataFrame({
    "Feature": X.columns,
    "Importance": importances
}).sort_values("Importance", ascending=True)

plt.figure(figsize=(8, 5))
plt.barh(feat_importance_df["Feature"], feat_importance_df["Importance"], color="#55A868")
plt.xlabel("Imporatnce")
plt.title("Feature Importance (from Decision Tree)")
plt.tight_layout()
plt.savefig("feature_importance.png", dpi=200)
print("Saved feature_importance.png")

plt.show()
